*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Unity Android native build cache
/.utmp/

# GameAnalytics settings hold the game secret key; created by Golden Mend > Prepare Analytics Settings
/[Aa]ssets/[Rr]esources/GameAnalytics/Settings.asset
/[Aa]ssets/[Rr]esources/GameAnalytics/Settings.asset.meta
